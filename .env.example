# ==============================================================================
# PII Detection & Secure PDF Redaction MVP - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO VERSION CONTROL
# Copy this file to .env and configure local/server values
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SYSTEM_VERSION=0.1.0
API_VERSION=v1
PIPELINE_VERSION=1.0.0

# Security & Sessions (Replace with random 32+ byte string in production)
JWT_SECRET_KEY=change-this-insecure-secret-key-for-local-dev-only-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage & Privacy
STORAGE_ROOT=./storage/private
TEMP_STORAGE_DIR=./storage/temp
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=100

# Processing & Resource Limits (OPS-03 alignment)
JOB_TIMEOUT_SECONDS=300
WORKER_CONCURRENCY=2
SAFE_LOGGING=true

# Model Serving & Versioning
DEFAULT_NER_MODEL=spacy_vn_19_ner
DEFAULT_NER_VERSION=1.0.0
CHECKPOINTS_DIR=./checkpoints
